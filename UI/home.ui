<?xml version="1.0" encoding="UTF-8"?>
<!-- ZeXis State Share - GTK UI Definition -->
<interface>
  <requires lib="gtk+" version="3.20"/>
  
  <object class="GtkWindow" id="main_window">
    <property name="title">ZeXis State Share</property>
    <property name="default-width">600</property>
    <property name="default-height">400</property>
    <property name="window-position">center</property>
    
    <child>
      <object class="GtkBox" id="main_container">
        <property name="visible">True</property>
        <property name="orientation">vertical</property>
        <property name="spacing">15</property>
        <property name="margin">20</property>
        
        <!-- Header -->
        <child>
          <object class="GtkLabel" id="header_label">
            <property name="visible">True</property>
            <property name="label">State Share</property>
            <property name="xalign">0</property>
            <attributes>
              <attribute name="scale" value="1.5"/>
              <attribute name="weight" value="bold"/>
            </attributes>
          </object>
        </child>
        
        <!-- App Selector -->
        <child>
          <object class="GtkBox" id="selector_box">
            <property name="visible">True</property>
            <property name="orientation">vertical</property>
            <property name="spacing">8</property>
            
            <child>
              <object class="GtkLabel" id="app_label">
                <property name="visible">True</property>
                <property name="label">Select running application:</property>
                <property name="xalign">0</property>
              </object>
            </child>
            
            <child>
              <object class="GtkComboBoxText" id="app_combo">
                <property name="visible">True</property>
              </object>
            </child>
          </object>
        </child>
        
        <!-- Action Buttons -->
        <child>
          <object class="GtkBox" id="button_box">
            <property name="visible">True</property>
            <property name="orientation">horizontal</property>
            <property name="spacing">10</property>
            <property name="halign">center</property>
            <property name="margin-top">20</property>
            
            <child>
              <object class="GtkButton" id="export_btn">
                <property name="visible">True</property>
                <property name="label">Export State</property>
                <style>
                  <class name="primary-button"/>
                </style>
              </object>
            </child>
            
            <child>
              <object class="GtkButton" id="import_btn">
                <property name="visible">True</property>
                <property name="label">Import State</property>
              </object>
            </child>
            
            <child>
              <object class="GtkButton" id="send_btn">
                <property name="visible">True</property>
                <property name="label">Send to Computer</property>
                <style>
                  <class name="send-button"/>
                </style>
              </object>
            </child>
          </object>
        </child>
        
        <!-- Status Label -->
        <child>
          <object class="GtkLabel" id="status_label">
            <property name="visible">True</property>
            <property name="label">Ready</property>
            <property name="xalign">0</property>
            <property name="margin-top">30</property>
            <style>
              <class name="status-label"/>
            </style>
          </object>
          <packing>
            <property name="pack-type">end</property>
          </packing>
        </child>
      </object>
    </child>
  </object>
</interface>